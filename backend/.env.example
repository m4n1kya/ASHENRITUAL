# ─────────────────────────────────────────────────────────────────────────────
# ASHENRITUAL BACKEND — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Server Port
PORT=3001

# Neon PostgreSQL Database URL (pooled connection string recommended)
# Example: postgres://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=

# Comma-separated list of allowed frontend origins (for CORS)
# Example: https://ashenritual.com,https://www.ashenritual.com
FRONTEND_URL=http://localhost:3000

# Secret keys for JWT Authentication
JWT_SECRET=
JWT_REFRESH_SECRET=

# Google Gemini API Key for VESPER
# Get a free key at: https://aistudio.google.com/
GOOGLE_GEMINI_API_KEY=

# Resend API Key for transactional emails (Optional for now)
# Get a free key at: https://resend.com/
RESEND_API_KEY=
