# ─────────────────────────────────────────────────────────────────────────────
# ASHENRITUAL BACKEND — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Server Port
PORT=3001

# Neon PostgreSQL Database URL (pooled connection string recommended)
# Example: postgres://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=

# Comma-separated list of allowed frontend origins (for CORS)
# Example: https://ashenritual.com,https://www.ashenritual.com
FRONTEND_URL=http://localhost:3000

# Secret keys for JWT Authentication
JWT_SECRET=
JWT_REFRESH_SECRET=

# Google Gemini API Key for VESPER
# Get a free key at: https://aistudio.google.com/
GOOGLE_GEMINI_API_KEY=

# Resend API Key for transactional emails (Optional for now)
# Get a free key at: https://resend.com/
RESEND_API_KEY=

# Google OAuth Authentication
# Setup instructions:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a new project, go to APIs & Services -> Credentials
# 3. Create OAuth 2.0 Client IDs (Web Application)
# 4. Add Authorized JavaScript origins (e.g. http://localhost:3000)
# 5. Add Authorized redirect URIs (e.g. http://localhost:4000/api/v1/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
