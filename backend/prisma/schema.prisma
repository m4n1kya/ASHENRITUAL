generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ─────────────────────────────────────────────────────────────

enum Role {
  USER
  CREATOR
  SHOWROOM_OWNER
  MODERATOR
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ConceptStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  FEATURED
  COMPETITION_ENTRY
  PROTOTYPE
}

enum ApplicationStatus {
  PENDING
  INTERVIEW
  APPROVED
  REJECTED
}

// ── MODELS ────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String?
  provider     String  @default("LOCAL")
  providerId   String? @unique

  // Profile Additions
  username           String?   @unique // [a-z0-9_] 3-20 chars
  displayName        String?
  avatar             String?
  banner             String?
  bio                String?   @db.Text
  country            String?
  state              String?
  city               String?
  role               Role      @default(USER)
  lastUsernameChange DateTime?

  // Auth & Security
  refreshToken         String?
  emailVerified        Boolean   @default(false)
  verificationToken    String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  // Relations
  savedRituals    SavedRitual[]
  archives        Archive[]
  reviews         Review[]
  addresses       Address[]
  vesperAnalytics VesperAnalytics[]

  // New Relational Extensions
  creator        Creator?
  ownedBrands    Brand[] // A user can own multiple brands
  ownedShowrooms Showroom[] @relation("ShowroomOwner")

  followers      Follow[]         @relation("UserFollowing")
  following      Follow[]         @relation("UserFollowers")
  bookmarks      Bookmark[]
  likes          Like[]
  comments       Comment[]
  notifications  Notification[]
  activityLog    ActivityLog[]
  ShowroomReview ShowroomReview[]
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  targetType String // 'PRODUCT', 'CREATOR', 'SHOWROOM', 'CONCEPT', 'COLLECTION'
  targetId   String // ID of the target
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  conceptId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
}

model Comment {
  id        String    @id @default(uuid())
  userId    String
  conceptId String
  content   String    @db.Text
  parentId  String? // For nested replies
  isPinned  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String // 'APPLICATION_ACCEPTED', 'FOLLOW', 'MILESTONE', etc.
  payload   Json? // Stores dynamic data (e.g., who followed, what milestone)
  actionUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String // 'UPLOADED_CONCEPT', 'APPLIED_SHOWROOM'
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── CREATOR ECOSYSTEM ─────────────────────────────────────────────────

model Creator {
  id             String  @id @default(uuid())
  userId         String  @unique
  specialization String?
  philosophy     String? @db.Text
  links          Json? // { instagram, website, behance, github }
  verification   String? // 'VERIFIED_CREATOR', 'VERIFIED_DESIGNER', 'FEATURED_CREATOR', null

  // Denormalized counts for fast querying
  portfolioCount Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  concepts     Concept[]
  collections  Collection[]
  applications ShowroomApplication[]
  showrooms    Showroom[]            @relation("ShowroomCreators")
}

model Concept {
  id           String   @id @default(uuid())
  creatorId    String
  collectionId String?
  title        String
  description  String?  @db.Text
  coverImage   String
  gallery      String[]
  category     String?
  season       String?

  // Metadata for AI Search
  tags         String[]
  materials    String[]
  softwareUsed String[]

  status         ConceptStatus @default(DRAFT)
  visibility     String        @default("PUBLIC") // PUBLIC, PRIVATE
  allowComments  Boolean       @default(true)
  allowDownloads Boolean       @default(false)

  // Analytics
  views          Int @default(0)
  likesCount     Int @default(0)
  bookmarksCount Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  creator    Creator          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  collection Collection?      @relation(fields: [collectionId], references: [id])
  versions   ConceptVersion[]
  likes      Like[]
  comments   Comment[]
}

model ConceptVersion {
  id            String   @id @default(uuid())
  conceptId     String
  versionNumber Int
  changes       String?  @db.Text
  gallery       String[]
  createdAt     DateTime @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
}

model Collection {
  id           String   @id @default(uuid())
  creatorId    String
  brandId      String?
  name         String
  description  String?  @db.Text
  coverImage   String?
  theme        String?
  season       String?
  colorPalette String[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  creator  Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  brand    Brand?    @relation(fields: [brandId], references: [id])
  concepts Concept[]
}

// ── BUSINESS & E-COMMERCE ECOSYSTEM ───────────────────────────────────

model Brand {
  id          String  @id @default(uuid())
  ownerId     String
  name        String  @unique
  slug        String  @unique
  description String? @db.Text
  logo        String?
  established Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products    Product[]
  collections Collection[]
}

model Showroom {
  id      String  @id @default(uuid())
  ownerId String? // Linked to User (SHOWROOM_OWNER)
  name    String
  slug    String  @unique
  country String  @default("India")
  state   String
  city    String
  address String?

  // Details
  description     String  @db.Text
  history         String? @db.Text
  specialization  String?
  knownFor        String?
  establishedYear Int?

  // Media
  image   String? // Cover
  logo    String?
  gallery String[]

  // Contact & Verification
  contactEmail String?
  phone        String?
  website      String?
  instagram    String?
  hours        String?
  verification String? // 'VERIFIED_SHOWROOM', 'OFFICIAL_PARTNER', 'PREMIUM_PARTNER', null

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner        User?                 @relation("ShowroomOwner", fields: [ownerId], references: [id])
  products     ProductShowroom[]
  creators     Creator[]             @relation("ShowroomCreators")
  applications ShowroomApplication[]
  reviews      ShowroomReview[]
}

model ShowroomApplication {
  id            String            @id @default(uuid())
  creatorId     String
  showroomId    String
  reason        String            @db.Text
  portfolioLink String?
  collections   String[] // IDs of collections included
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  creator  Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  showroom Showroom @relation(fields: [showroomId], references: [id], onDelete: Cascade)
}

model ShowroomReview {
  id         String  @id @default(uuid())
  userId     String
  showroomId String
  comment    String? @db.Text

  // Detailed Ratings
  quality      Int @default(5)
  tailoring    Int @default(5)
  service      Int @default(5)
  authenticity Int @default(5)
  price        Int @default(5)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  showroom Showroom @relation(fields: [showroomId], references: [id], onDelete: Cascade)
}

model Product {
  id          String   @id @default(uuid())
  brandId     String?
  name        String
  description String   @db.Text
  price       Decimal  @db.Decimal(10, 2)
  images      String[]
  stock       Int      @default(0)
  categoryId  String

  // AI Search & Metadata
  tags String[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  brand      Brand?            @relation(fields: [brandId], references: [id])
  category   Category          @relation(fields: [categoryId], references: [id])
  showrooms  ProductShowroom[]
  savedBy    SavedRitual[]
  orderItems OrderItem[]
  reviews    Review[]
  chapters   Chapter[]         @relation("ChapterProducts")
}

model ProductShowroom {
  productId  String
  showroomId String

  // Optional: Price override or inventory specific to showroom
  stock Int?

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  showroom Showroom @relation(fields: [showroomId], references: [id], onDelete: Cascade)

  @@id([productId, showroomId])
}

// ── EXISTING MODELS (Unchanged Structure) ─────────────────────────────

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Chapter {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String?   @unique
  description String?
  quote       String?   @db.Text
  quoteAuthor String?
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[] @relation("ChapterProducts")
}

model SavedRitual {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Archive {
  id        String      @id @default(uuid())
  userId    String
  total     Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  archiveId String
  productId String
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2)
  archive   Archive @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int      @default(5)
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  street    String
  city      String
  zip       String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique
  discountType DiscountType
  value        Decimal      @db.Decimal(10, 2)
  expiry       DateTime
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model VesperAnalytics {
  id             String   @id @default(uuid())
  userId         String?
  queryIntent    String?
  contextPayload String?  @db.Text
  responseType   String?
  productIds     String?
  responseTimeMs Int?
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
